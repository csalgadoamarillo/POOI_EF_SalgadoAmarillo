@model POOI_EF_SalgadoAmarillo.Models.Consumidor
@{
    ViewBag.Title = "Agregar consumidor";
}

<h2>Agregar consumidor</h2>
@if (ViewBag.Mensaje != null)
{
    <p>@ViewBag.Mensaje</p>
}

@using (Html.BeginForm("Create", "Consumidor", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="campo">
        @Html.LabelFor(m => m.dnicont)
        @Html.TextBoxFor(m => m.dnicont, new { maxlength = "8", pattern = "[0-9]{8}", required = "required" })
        @Html.ValidationMessageFor(m => m.dnicont)
    </div>
    <div class="campo">
        @Html.LabelFor(m => m.nomcont)
        @Html.TextBoxFor(m => m.nomcont, new { maxlength = "40", required = "required" })
        @Html.ValidationMessageFor(m => m.nomcont)
    </div>
    <div class="campo">
        @Html.LabelFor(m => m.apecont)
        @Html.TextBoxFor(m => m.apecont, new { maxlength = "40", required = "required" })
        @Html.ValidationMessageFor(m => m.apecont)
    </div>
    <div class="campo">
        @Html.LabelFor(m => m.emailcont)
        @Html.TextBoxFor(m => m.emailcont, new { type = "email", maxlength = "250" })
        @Html.ValidationMessageFor(m => m.emailcont)
    </div>

    <div class="campo">
        @Html.LabelFor(m => m.idpais)
        @Html.DropDownListFor(m => m.idpais, (IEnumerable<SelectListItem>)ViewBag.Paises, "Seleccione un país")
        @Html.ValidationMessageFor(m => m.idpais)
    </div>
    <button type="submit">Guardar</button>
}
<p>@Html.ActionLink("Volver al listado", "Index")</p>
