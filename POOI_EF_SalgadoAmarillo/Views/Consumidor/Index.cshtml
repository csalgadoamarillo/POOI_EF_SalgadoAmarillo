@model List<POOI_EF_SalgadoAmarillo.Models.Consumidor>
@{
    ViewBag.Title = "Consumidores";
}

<h2>Consumidores</h2>
<p>@Html.ActionLink("Agregar consumidor", "Create")</p>
@if (TempData["Mensaje"] != null)
{
    <p>@TempData["Mensaje"]</p>
}

@if (Model.Count == 0)
{
    <p>No hay registros</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>DNI</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Correo</th>
                <th>País</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var consumidor in Model)
            {
                <tr>
                    <td>@consumidor.dnicont</td>
                    <td>@consumidor.nomcont</td>
                    <td>@consumidor.apecont</td>
                    <td>@consumidor.emailcont</td>
                    <td>@consumidor.idpais</td>
                    <td>
                        @Html.ActionLink("Detalles", "Details", new { dni = consumidor.dnicont }) |
                        @Html.ActionLink("Actualizar", "Update", new { dni = consumidor.dnicont })
                        @using (Html.BeginForm("Delete", "Consumidor", FormMethod.Post, new { @class = "en-linea" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("dni", consumidor.dnicont)
                            <button type="submit">Eliminar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
